<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist keys merged into the generated macOS and iOS bundles by tauri (the iOS bundle picks
  these up too, see gen/apple/kite-gc_iOS/Info.plist).
  Bluetooth: required so CoreBluetooth (btleplug / native BLE transport) is permitted; without a usage
  string Apple denies BLE central access. Mirrors the capability Windows/Linux already have.
  Camera: required for the video panel's "Camera (device)" source (getUserMedia over a USB/UVC capture
  device, e.g. an HDMI capture card fed from FPV goggles/VRX), the same webcam access desktop has.
  Location (when-in-use): lets the WebView Geolocation API resolve the operator's position so the map
  can open where the user is and the GCS marker is placed correctly. Coarse (city-level) is enough.
-->
<plist version="1.0">
<dict>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Kite Ground Control uses Bluetooth to connect to your flight controller / telemetry link over BLE.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Kite Ground Control uses Bluetooth to connect to your flight controller / telemetry link over BLE.</string>
    <key>NSCameraUsageDescription</key>
    <string>Kite Ground Control uses the camera to display an FPV video feed from a connected capture device.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Kite Ground Control uses your location to center the map on you and place the ground-station marker.</string>
</dict>
</plist>
