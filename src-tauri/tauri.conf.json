{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kite Ground Control",
  "version": "../package.json",
  "identifier": "com.kitegc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Kite Ground Control",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,WebRtcHideLocalIpsWithMdns"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyRTI4OTQ0Rjg5NUI0QTUKUldTbHRKWDRSSW5pa2g0SmVXOUZPeFdTYnh3Vkl2UjBjZU1GbGZnVjJPS3prRkZ3RUVaajIzeEUK",
      "endpoints": ["https://github.com/b14ckyy/Kite-GC/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "rpm"],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-gtk3",
          "gstreamer1.0-nice",
          "gstreamer1.0-libav"
        ],
        "recommends": ["gstreamer1.0-tools"]
      },
      "rpm": {
        "recommends": [
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "libnice-gstreamer1"
        ]
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
